# Dependencies (never a node_modules at this folder — apps and js-lint/ install locally)
node_modules/

# Vite / Vitest local caches
.vite-cache/
.vitest-cache/

# Rust workspace
target/

# Logs / OS
*.log
.DS_Store
Thumbs.db

# Env (never commit secrets)
.env
.env.*

# Electron build output (each app also has local .gitignore)
apps/electron/dist/
# Official WinFsp MSI fetched by apps/electron/scripts/fetch-winfsp.cjs
apps/electron/build/winfsp/*.msi

# Local vault-root created by `electron:dev` (app home = this `dev/` folder)
.upriv/
# Unlocked folder beside the data folder (Beside the data folder choice)
/upriv-unlocked/
.upriv-data-folder
.upriv-invalidated-*

# Temp
temp/
