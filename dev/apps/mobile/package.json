{
  "name": "upriv-mobile",
  "version": "0.2.2-beta",
  "private": true,
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:native": "expo run:android",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "node ../../js-lint/bin/run.mjs eslint . --max-warnings 0",
    "lint:fix": "node ../../js-lint/bin/run.mjs eslint . --fix",
    "format": "node ../../js-lint/bin/run.mjs prettier --write .",
    "format:check": "node ../../js-lint/bin/run.mjs prettier --check .",
    "build:ffi": "bash ../../scripts/build-android-ffi.sh"
  },
  "dependencies": {
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@upriv/shared": "file:../shared",
    "base64-js": "^1.5.1",
    "expo": "52.0.49",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-sharing": "~13.0.1",
    "expo-status-bar": "2.0.1",
    "fflate": "^0.8.3",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "4.4.0",
    "react-native-svg": "15.8.0",
    "upriv-core": "file:./modules/upriv-core"
  },
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@types/react": "18.3.18",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "12.0.12",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
