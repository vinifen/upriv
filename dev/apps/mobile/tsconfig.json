{
  "extends": "./node_modules/expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@upriv/shared": ["../shared/src/index.ts"],
      "@upriv/shared/*": ["../shared/src/*"],
      "upriv-core": ["./modules/upriv-core/src/index.ts"]
    },
    "resolveJsonModule": true
  },
  "include": ["**/*.ts", "**/*.tsx", "../shared/locales/*.json"]
}
